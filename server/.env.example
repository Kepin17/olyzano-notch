# Copy to .env and fill in. Never commit .env.

# Domain that points (A/AAAA record) to this VPS, e.g. share.example.com
DOMAIN=share.example.com

# Secret that lets Notch upload. Generate: openssl rand -hex 32
RELAY_API_KEY=

# Limits
MAX_FILE_MB=5120
MAX_TOTAL_MB=20480
MAX_TTL_HOURS=24

# Cloud shelf (optional). Any S3-compatible store: MinIO, Backblaze B2, Wasabi, Cloudflare R2, AWS S3...
# The bucket must exist. With the bundled MinIO (docker compose --profile minio up -d --build):
#   S3_ENDPOINT=http://minio:9000 and the access/secret key below become MinIO's own root user; create the bucket
#   once with the minio/mc image (see README, "Cloud shelf").
# S3_ENDPOINT=http://minio:9000
# S3_BUCKET=notch
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
# CLOUD_MAX_TOTAL_MB=20480

# Used only to print invitation links (docker compose sets it from DOMAIN; set it yourself behind nginx)
# PUBLIC_URL=https://share.example.com
